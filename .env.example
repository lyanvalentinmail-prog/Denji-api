# ---------------------------------------------------------------------------
# Denji API — variables de entorno
# Copia este archivo a .env y completa solo lo que necesites.
# Todo lo que no esta aqui funciona SIN claves.
# ---------------------------------------------------------------------------

# Puerto del servidor (Render y Vercel lo inyectan solos)
PORT=3000

# Peticiones por minuto por IP
RATE_LIMIT_MAX=180

# Timeout de las peticiones a proveedores externos (ms)
UPSTREAM_TIMEOUT_MS=20000

# --- AI ---------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
STABILITY_API_KEY=
IMAGEN_API_KEY=

# --- Busqueda de Spotify ----------------------------------------------------
# Sin estas claves /busquedas/spotify usa Deezer como alternativa (lo indica en "source")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Rule34 -----------------------------------------------------------------
# La API oficial pidio autenticacion; sin claves se usa la comunidad espejo de Reddit
RULE34_USER_ID=
RULE34_API_KEY=

# --- YouTube ----------------------------------------------------------------
# Instancias publicas separadas por coma. Pon las tuyas si las publicas fallan.
PIPED_INSTANCES=
INVIDIOUS_INSTANCES=

# --- Aptoide ----------------------------------------------------------------
APTOIDE_HOST=https://ws75.aptoide.com

# --- NSFW -------------------------------------------------------------------
# Pon 1 para deshabilitar por completo los endpoints +18 en este servidor
NSFW_DISABLED=0
